{
  "info": {
    "_postman_id": "98ee3aa3-a123-4989-862a-7d72ff6126ed",
    "name": "Payshop Mobile App APIs",
    "description": "Complete Postman Collection for Payshop Multivendor E-Commerce Mobile App.\nAll new requested endpoints are implemented in POST method with standard { status: true/false } responses.\nSupports both Sanctum Bearer token and user_id in request body.\nIncludes Unified User Authentication (Single API for both Sign In and Sign Up).\nIncludes Currency Lists API (POST /api/currency-lists) and automatic price conversion across all product and checkout APIs.\nIncludes Multi Quantity Price (MOQ) Tiers in Product Details API matching payshop_ecm_modify.\nIncludes Exactly Two APIs for Checkout (Cart Details -> Save Order) linked by cart_id.\nUnit total is provided from the body in Cart Details API.\nDelivery charge is computed automatically from place_type ('inside_city' or 'outside_city') in user selected currency.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "currency",
      "value": "bdt_rate",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "cart_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "order_id",
      "value": "1",
